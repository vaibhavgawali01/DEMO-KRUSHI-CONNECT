{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/products", "destination": "/products.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/weather", "destination": "/weather.html" },
    { "source": "/farming-tips", "destination": "/farming-tips.html" },
    { "source": "/fertilizer-calculator", "destination": "/fertilizer-calc.html" },
    { "source": "/fertilizer-calc", "destination": "/fertilizer-calc.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/offers", "destination": "/offers.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/forgot-password", "destination": "/forgot-password.html" },
    { "source": "/admin", "destination": "/admin-dashboard.html" },
    { "source": "/admin/dashboard", "destination": "/admin-dashboard.html" },
    { "source": "/admin-dashboard", "destination": "/admin-dashboard.html" },
    { "source": "/admin/products", "destination": "/admin-products.html" },
    { "source": "/admin-products", "destination": "/admin-products.html" },
    { "source": "/admin/products/add", "destination": "/admin-product-form.html" },
    { "source": "/admin/product-form", "destination": "/admin-product-form.html" },
    { "source": "/admin-product-form", "destination": "/admin-product-form.html" },
    { "source": "/admin/categories", "destination": "/admin-categories.html" },
    { "source": "/admin-categories", "destination": "/admin-categories.html" },
    { "source": "/admin/udhari", "destination": "/admin-udhari.html" },
    { "source": "/admin-udhari", "destination": "/admin-udhari.html" },
    { "source": "/admin/inventory", "destination": "/admin-inventory.html" },
    { "source": "/admin-inventory", "destination": "/admin-inventory.html" },
    { "source": "/admin/customers", "destination": "/admin-customers.html" },
    { "source": "/admin-customers", "destination": "/admin-customers.html" },
    { "source": "/admin/reviews", "destination": "/admin-reviews.html" },
    { "source": "/admin-reviews", "destination": "/admin-reviews.html" },
    { "source": "/admin/reports", "destination": "/admin-reports.html" },
    { "source": "/admin-reports", "destination": "/admin-reports.html" },
    { "source": "/admin/backup", "destination": "/admin-backup.html" },
    { "source": "/admin-backup", "destination": "/admin-backup.html" },
    { "source": "/admin/settings", "destination": "/admin-settings.html" },
    { "source": "/admin-settings", "destination": "/admin-settings.html" },
    { "source": "/farmer/dashboard", "destination": "/farmer-dashboard.html" },
    { "source": "/farmer-dashboard", "destination": "/farmer-dashboard.html" },
    { "source": "/customer/dashboard", "destination": "/farmer-dashboard.html" },
    { "source": "/profile", "destination": "/farmer-profile.html" },
    { "source": "/farmer/profile", "destination": "/farmer-profile.html" },
    { "source": "/customer/profile", "destination": "/farmer-profile.html" },
    { "source": "/farmer-profile", "destination": "/farmer-profile.html" },
    { "source": "/orders", "destination": "/farmer-orders.html" },
    { "source": "/farmer/orders", "destination": "/farmer-orders.html" },
    { "source": "/customer/orders", "destination": "/farmer-orders.html" },
    { "source": "/farmer-orders", "destination": "/farmer-orders.html" },
    { "source": "/farmer/udhari", "destination": "/farmer-udhari.html" },
    { "source": "/customer/udhari", "destination": "/farmer-udhari.html" },
    { "source": "/farmer-udhari", "destination": "/farmer-udhari.html" },
    { "source": "/farmer/pay", "destination": "/farmer-pay.html" },
    { "source": "/customer/pay", "destination": "/farmer-pay.html" },
    { "source": "/farmer-pay", "destination": "/farmer-pay.html" },
    { "source": "/farmer/payments", "destination": "/farmer-payments.html" },
    { "source": "/customer/payments", "destination": "/farmer-payments.html" },
    { "source": "/farmer-payments", "destination": "/farmer-payments.html" },
    { "source": "/farmer/notifications", "destination": "/farmer-notifications.html" },
    { "source": "/customer/notifications", "destination": "/farmer-notifications.html" },
    { "source": "/farmer-notifications", "destination": "/farmer-notifications.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
